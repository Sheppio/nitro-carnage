{
  "name": "nitrocarnage",
  "version": "0.1.3",
  "private": true,
  "description": "Serverless top-down 3D combat racer for 1-6 players over MQTT/WebSockets.",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "check": "tsc --noEmit",
    "serve": "python3 -m http.server 8080",
    "test": "npm run build && node test/sim.test.mjs && node test/smoke.test.mjs",
    "test:sim": "node test/sim.test.mjs",
    "test:smoke": "node test/smoke.test.mjs",
    "test:consistency": "node test/consistency.mjs",
    "prepare": "git config core.hooksPath .githooks || true",
    "version:bump": "node scripts/bump-version.mjs"
  },
  "devDependencies": {
    "@types/three": "0.186.0",
    "mqtt": "5.15.2",
    "playwright": "1.63.0",
    "three": "0.186.1",
    "typescript": "5.9.3"
  }
}
